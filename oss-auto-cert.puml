@startuml
!pragma layout smetana
left to right direction

skinparam backgroundColor #FFFFFF
skinparam defaultFontName "Microsoft YaHei"
skinparam defaultFontSize 16
skinparam shadowing false
skinparam roundcorner 16
skinparam ArrowColor #94A3B8
skinparam ArrowThickness 2
skinparam rectangle {
  BorderColor #CBD5E1
  FontColor #0F172A
  BackgroundColor #F8FAFC
}
skinparam padding 12
skinparam ranksep 24

rectangle "<b>01  检查</b>\n域名与证书有效期" as inspect #F1F5F9
rectangle "<b>02  准备</b>\n申请或复用证书" as prepare #EFF6FF
rectangle "<b>03  上传</b>\n保存到阿里云 CAS" as upload #EFF6FF
rectangle "<b>04  部署</b>\n更新 OSS / CDN" as deploy #EFF6FF
rectangle "<b>05  通知</b>\n发送处理结果" as notify #ECFDF5

inspect --> prepare : 按需处理
prepare --> upload
upload --> deploy
deploy --> notify
@enduml
